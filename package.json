{
  "name": "motion-fit",
  "productName": "MotionFit",
  "version": "0.1.0",
  "private": true,
  "description": "Webcam motion-controlled 3D exercise game",
  "author": "MotionFit",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs",
    "setup-assets": "node scripts/setup-assets.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron . --windowed",
    "desktop:dev": "electron . --dev --windowed",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.motionfit.app",
    "productName": "MotionFit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MotionFit"
    },
    "portable": {
      "artifactName": "MotionFit-${version}-portable.exe"
    }
  }
}
